@model Laboratorio203.Models.Laptop
@{
    ViewBag.Title = "Editar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2>Editar producto</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-md-2">Nombre</label>
            <div class="col-md-10">@Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })</div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-2">Precio</label>
            <div class="col-md-10">@Html.TextBoxFor(m => m.Precio, new { @class = "form-control", type = "number", step = "0.01" })</div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-2">Stock</label>
            <div class="col-md-10">@Html.TextBoxFor(m => m.Stock, new { @class = "form-control", type = "number" })</div>
        </div>
        <div class="form-group" style="margin-top:12px;">
            <button type="submit" class="btn btn-success">Guardar</button>
            <a class="btn btn-default" href="@Url.Action("Index")">Cancelar</a>
        </div>
    </div>
}