@model IEnumerable<Laboratorio203.Models.Laptop>
    @{
        ViewBag.Title = "Productos (Laptops)";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }
    <h2>Productos</h2>

    <div style="display:flex; gap:8px; align-items:center; margin-bottom:12px;">
        <a class="btn btn-primary" href="@Url.Action("Create")">Nuevo</a>
        <form method="get" action="@Url.Action("Index")" style="display:flex; gap:8px; align-items:center;">
            <label for="buscarId">Buscar por id:</label>
            <input type="number" min="1" id="buscarId" name="buscarId" class="form-control" style="width:120px;" />
            <button type="submit" class="btn btn-secondary">Buscar</button>
        </form>
    </div>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Stock</th>
                <th style="width:240px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Nombre</td>
                    <td>@item.Precio</td>
                    <td>@item.Stock</td>
                    <td>
                        <a class="btn btn-info" href="@Url.Action("Details", new { id = item.Id })">Ver</a>
                        <a class="btn btn-warning" href="@Url.Action("Edit", new { id = item.Id })">Editar</a>
                        <a class="btn btn-danger" href="@Url.Action("Delete", new { id = item.Id })">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
