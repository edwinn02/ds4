@{
    ViewBag.Title = "Calculadora";
}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card mt-4">
                <div class="card-header">
                    <h3 class="text-center">Calculadora Web</h3>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label for="numero1">Primer Número:</label>
                        <input type="number" class="form-control" id="numero1" step="any" required>
                    </div>
                    <div class="form-group mb-3">
                        <label for="operacion">Operación:</label>
                        <select class="form-control" id="operacion">
                            <option value="+">Suma (+)</option>
                            <option value="-">Resta (-)</option>
                            <option value="*">Multiplicación (*)</option>
                            <option value="/">División (/)</option>
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label for="numero2">Segundo Número:</label>
                        <input type="number" class="form-control" id="numero2" step="any" required>
                    </div>
                    <div class="text-center">
                        <button class="btn btn-primary" onclick="calcular()">Calcular</button>
                    </div>
                    <div class="mt-3 d-none" id="resultadoContainer">
                        <h4>Resultado:</h4>
                        <div id="resultado" class="alert alert-info"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function calcular() {
            var numero1 = document.getElementById('numero1').value;
            var numero2 = document.getElementById('numero2').value;
            var operacion = document.getElementById('operacion').value;

            // Validación de campos vacíos
            if (!numero1 || !numero2) {
                alert('Por favor, ingrese ambos números');
                return;
            }

            // Validación de división por cero
            if (operacion === '/' && parseFloat(numero2) === 0) {
                alert('No se puede dividir por cero');
                return;
            }

            $.ajax({
                url: '@Url.Action("Calcular", "Home")',
                type: 'POST',
                data: {
                    numero1: parseFloat(numero1),
                    numero2: parseFloat(numero2),
                    operacion: operacion
                },
                success: function (data) {
                    // ERROR CORREGIDO: No uses JSON.parse si el controlador retorna Json()
                    // jQuery ya parsea automáticamente la respuesta JSON

                    // Verificar si hubo un error
                    if (data.success === false) {
                        alert(data.message || 'Error al realizar el cálculo');
                        return;
                    }

                    // Mostrar el resultado
                    document.getElementById('resultado').innerHTML =
                        numero1 + ' ' + operacion + ' ' + numero2 + ' = ' + data.Resultado;

                    // Mostrar el contenedor usando Bootstrap
                    document.getElementById('resultadoContainer').classList.remove('d-none');
                },
                error: function (xhr) {
                    var errorMsg = 'Error al realizar el cálculo';

                    // Intentar obtener mensaje de error del servidor
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }

                    alert(errorMsg);
                    console.error('Error completo:', xhr);
                }
            });
        }
    </script>
}